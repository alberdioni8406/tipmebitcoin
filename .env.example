# TipMeBitcoin V1 — environment template
# Copy to .env for local development. Never commit real secrets.

# Required: hosted PostgreSQL connection string (Neon, Vercel Postgres, etc.)
# Local example (Neon free tier or local Postgres):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Canonical application URL (no trailing slash)
# Local:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel):
NEXT_PUBLIC_APP_URL=https://tipmebitcoin.vercel.app

# Optional override for project donation address (already set in code)
# NEXT_PUBLIC_PROJECT_DONATION_BCH_ADDRESS=bitcoincash:qrtv37u522gz8a5lezfqk5vukly93cu7gc8tn09040

# Development only — never enable in production
# ALLOW_DEV_SIGNATURE_BYPASS=true
