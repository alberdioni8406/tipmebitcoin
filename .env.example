# TipMeBitcoin V1 — environment template
# Copy to .env for local development. Never commit real secrets.

# Required: hosted PostgreSQL (Neon pooled URL recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Canonical application URL (no trailing slash)
# Local:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel default):
NEXT_PUBLIC_APP_URL=https://tipmebitcoin.vercel.app
# When you attach a custom domain (example):
# NEXT_PUBLIC_APP_URL=https://tipmebitcoin.cash

# WalletConnect / Reown Cloud project ID (required for Connect wallet)
# https://cloud.reown.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional override for project donation address (already set in src/config/project.ts)
# NEXT_PUBLIC_PROJECT_DONATION_BCH_ADDRESS=bitcoincash:qrtv37u522gz8a5lezfqk5vukly93cu7gc8tn09040

# Development only — never enable in production
# ALLOW_DEV_SIGNATURE_BYPASS=true
